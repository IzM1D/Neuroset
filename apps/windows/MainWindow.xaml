<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Neuroset.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Neuroset.App.Localization"
    Title="Neuroset">
    <Grid x:Name="WindowRoot">
        <Frame x:Name="RootFrame" />
        <Grid x:Name="WindowChrome" Height="40" VerticalAlignment="Top" Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid x:Name="WindowDragRegion" Background="Transparent"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Click="OnMinimize" Style="{StaticResource CaptionButtonStyle}" AutomationProperties.Name="{loc:Loc Key=Minimize}" ToolTipService.ToolTip="{loc:Loc Key=Minimize}"><Path Data="M 0,5 L 10,5" Width="10" Height="10" Stroke="{ThemeResource TextBrush}" StrokeThickness="1"/></Button>
                <Button x:Name="MaximizeButton" Click="OnMaximize" Style="{StaticResource CaptionButtonStyle}" AutomationProperties.Name="{loc:Loc Key=Maximize}" ToolTipService.ToolTip="{loc:Loc Key=Maximize}"><Grid Width="12" Height="12"><Path x:Name="MaximizeGlyph" Data="M 1,1 L 10,1 L 10,10 L 1,10 Z" Stroke="{ThemeResource TextBrush}" StrokeThickness="1"/><Path x:Name="RestoreGlyph" Data="M 3,0 L 11,0 L 11,8 M 0,3 L 8,3 L 8,11 L 0,11 Z" Stroke="{ThemeResource TextBrush}" StrokeThickness="1" Visibility="Collapsed"/></Grid></Button>
                <Button x:Name="CloseWindowButton" Click="OnCloseWindow" Style="{StaticResource CaptionButtonStyle}" AutomationProperties.Name="{loc:Loc Key=Close}" ToolTipService.ToolTip="{loc:Loc Key=Close}">
                    <Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C42B40"/><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A82234"/><SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/><SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/></Button.Resources>
                    <Path Data="M 1,1 L 10,10 M 10,1 L 1,10" Width="12" Height="12" Stroke="{Binding Foreground,ElementName=CloseWindowButton}" StrokeThickness="1"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
