<Project Sdk="Uno.Sdk/6.7.22">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Neuroset.App</RootNamespace>
    <UnoSingleProject>true</UnoSingleProject>
    <UnoFeatures>SkiaRenderer;Toolkit</UnoFeatures>
    <ApplicationTitle>Neuroset</ApplicationTitle>
    <ApplicationId>app.neuroset.client</ApplicationId>
    <ApplicationDisplayVersion>1.0.4</ApplicationDisplayVersion>
    <ApplicationVersion>5</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <Import Project="../../src/App/Neuroset.App.Shared.projitems" />
  <ItemGroup>
    <ProjectReference Include="../../src/Infrastructure/Neuroset.Infrastructure.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="ColorCode.Core" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
</Project>
