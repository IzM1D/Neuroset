    <StaticResource x:Key="MenuFlyoutSubItemBackgroundDisabled" ResourceKey="TransparentBrush"/>
    <StaticResource x:Key="MenuFlyoutSubItemForegroundDisabled" ResourceKey="SubtleTextBrush"/>
    <StaticResource x:Key="MenuFlyoutSubItemBackgroundSubMenuOpened" ResourceKey="SelectionBrush"/>
