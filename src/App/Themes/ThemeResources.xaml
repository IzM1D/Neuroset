    <Style TargetType="MenuFlyoutSubItem" BasedOn="{StaticResource DefaultMenuFlyoutSubItemStyle}">
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusBrush}"/>
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource SurfaceBrush}"/>
        <Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="34"/>
        <Setter Property="CornerRadius" Value="{ThemeResource SmallCornerRadius}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextBrush}"/>
    </Style>
    <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
        <Setter Property="Background" Value="{ThemeResource PopupSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusBrush}"/>
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource SurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="{ThemeResource SmallCornerRadius}"/>
        <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTipStyle}">
        <Setter Property="Background" Value="{ThemeResource PopupSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{ThemeResource SmallCornerRadius}"/>
        <Setter Property="Padding" Value="11,7"/><Setter Property="FontSize" Value="12"/>
