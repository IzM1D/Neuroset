<UserControl
    x:Class="Neuroset.App.Controls.PresentationSlideView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True">
    <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <Canvas x:Name="Scene" Width="960" Height="540">
            <Canvas.Clip><RectangleGeometry Rect="0,0,960,540"/></Canvas.Clip>
        </Canvas>
    </Viewbox>
</UserControl>
