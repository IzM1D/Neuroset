<UserControl
    x:Class="Neuroset.App.Controls.PresentationFileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Neuroset.App.Localization">
    <Border Background="{ThemeResource ElevatedSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
        <StackPanel Spacing="10">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8A5;" FontSize="30" VerticalAlignment="Center" Foreground="{ThemeResource AccentBrush}"/>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DetailsText" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="ChangesText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="OpenButton" Click="OnOpenClick" Content="{loc:Loc Key='View and edit'}"/>
                <Button x:Name="SaveButton" Click="OnSaveClick" Content="{loc:Loc Key='Save presentation'}"/>
                <Button x:Name="ExternalButton" Click="OnExternalClick" ToolTipService.ToolTip="{loc:Loc Key='Open in another app'}" AutomationProperties.Name="{loc:Loc Key='Open in another app'}"><FontIcon Glyph="&#xE8A7;" FontSize="14"/></Button>
            </StackPanel>
            <TextBlock Text="{loc:Loc Key='View slides and edit text, style and animations here, or describe a specific change in the chat.'}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}"/>
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}"/>
        </StackPanel>
    </Border>
</UserControl>
