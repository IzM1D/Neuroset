<UserControl
    x:Class="Neuroset.App.Controls.HtmlArtifactView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Neuroset.App.Localization">
    <Border Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="{ThemeResource CardCornerRadius}" Padding="10">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title,ElementName=Root}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="{loc:Loc Key='Loading…'}" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/>
            </Grid>
            <Border Grid.Row="1" Background="#101010" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <WebView2 x:Name="Viewer" Height="480" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
