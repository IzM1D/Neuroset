<UserControl x:Class="Neuroset.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="using:Neuroset.App.Converters" xmlns:loc="using:Neuroset.App.Localization" xmlns:services="using:Neuroset.App.Services">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <converters:LocalizedValueConverter x:Key="LocalizedValue"/>
        <DataTemplate x:Key="ConnectionKeyHeaderTemplate"><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
        <Style x:Key="SettingsNavigationItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource ConversationItemStyle}"><Setter Property="MinWidth" Value="0"/></Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}"><Setter Property="CornerRadius" Value="{ThemeResource SmallCornerRadius}"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
        <Style TargetType="ToggleSwitch"><Setter Property="OnContent" Value="{loc:Loc Key=Enabled}"/><Setter Property="OffContent" Value="{loc:Loc Key=Disabled}"/></Style>
        <Thickness x:Key="SettingsPageHeaderPadding">0,0,0,18</Thickness>
        <Thickness x:Key="SettingsPageContentPadding">24</Thickness>
        <Style x:Key="SettingsPageHeaderStyle" TargetType="Border"><Setter Property="Padding" Value="{StaticResource SettingsPageHeaderPadding}"/></Style>
        <Style x:Key="SettingsPageContentStyle" TargetType="StackPanel"><Setter Property="Padding" Value="{StaticResource SettingsPageContentPadding}"/><Setter Property="Spacing" Value="18"/></Style>
        <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}"><Setter Property="FontSize" Value="30"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontWeight" Value="Light"/></Style>
        <Style x:Key="SettingsPageDescriptionStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="MaxWidth" Value="860"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
        <DataTemplate x:Key="SettingsNavigationTemplate">
            <Grid Padding="12,10" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="{Binding Glyph}" FontSize="16" Foreground="{ThemeResource SecondaryTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CompactSettingsNavigationTemplate"><Grid Padding="12,10" ToolTipService.ToolTip="{Binding Title}"><FontIcon Glyph="{Binding Glyph}" FontSize="17" Foreground="{ThemeResource SecondaryTextBrush}"/></Grid></DataTemplate>
    </UserControl.Resources>
    <Grid x:Name="SettingsRoot" Background="Transparent" SizeChanged="OnSettingsSizeChanged">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SettingsSidebarColumn" Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="SettingsSidebar" Background="{ThemeResource SidebarSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Padding="16,56,16,20" RowSpacing="24">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Button Click="OnCloseClick" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" AutomationProperties.Name="{loc:Loc Key='Back to chat'}" ToolTipService.ToolTip="{loc:Loc Key='Back to chat'}"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE76B;" FontSize="14"/><TextBlock x:Name="BackLabel" Text="{loc:Loc Key='Back to chat'}" FontSize="13"/></StackPanel></Button>
                <ListView x:Name="SettingsNavigation" Grid.Row="1" Background="Transparent" ItemContainerStyle="{StaticResource SettingsNavigationItemStyle}" ItemTemplate="{StaticResource SettingsNavigationTemplate}" SelectionMode="Single" SelectionChanged="OnSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Loc Key=Settings}"/>
                <StackPanel x:Name="SettingsFooter" Grid.Row="2" Margin="12,0" Spacing="5"><TextBlock Text="Neuroset" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{loc:Loc Key='Your workspace'}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11"/></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition x:Name="SettingsTopRow" Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <ComboBox x:Name="MobileSectionPicker" Margin="12,12,12,0" DisplayMemberPath="Title" SelectionChanged="OnMobileSectionChanged" Visibility="Collapsed" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Loc Key=Settings}"/>
            <Grid Grid.Row="1" Padding="28,16" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock Text="{loc:Loc Key=Settings}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12"/><TextBlock Text="/" Foreground="{ThemeResource SubtleTextBrush}" FontSize="12"/><TextBlock x:Name="SectionBreadcrumb" FontSize="12"/></StackPanel>
                <Button Grid.Column="1" Click="OnCloseClick" Style="{StaticResource QuietIconButtonStyle}" AutomationProperties.Name="{loc:Loc Key=Close}" ToolTipService.ToolTip="{loc:Loc Key='Back to chat'}"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>
            </Grid>
            <ScrollViewer x:Name="SettingsScroller" Grid.Row="2" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <Grid x:Name="SettingsContent" MaxWidth="960" Padding="32,20,32,40" HorizontalAlignment="Stretch">
                        <Grid x:Name="GeneralPanel">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource SettingsPageHeaderStyle}"><TextBlock Text="{loc:Loc Key=General}" Style="{StaticResource SettingsPageTitleStyle}"/></Border>
                            <Border Grid.Row="1" Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource GlassBorderBrush}" BorderThickness="1" CornerRadius="{ThemeResource SuggestionCornerRadius}"><StackPanel Style="{StaticResource SettingsPageContentStyle}">
                                <TextBlock Text="{loc:Loc Key='Local-first AI client settings. Your conversations, knowledge, memory, and schedules stay on this device.'}" Style="{StaticResource SettingsPageDescriptionStyle}"/>
                                <ComboBox Header="{loc:Loc Key='Interface language'}" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectedValue="{Binding InterfaceLanguage,Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                <TextBlock Text="{loc:Loc Key='Language changes are applied after restarting Neuroset.'}" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                <Button Content="{loc:Loc Key='Restart Neuroset'}" Command="{Binding RestartApplicationCommand}" Style="{StaticResource PremiumButtonStyle}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding LanguageStatus}" Foreground="{ThemeResource SuccessBrush}" TextWrapping="Wrap"/>
                                <ToggleSwitch Header="{loc:Loc Key='Long-term memory'}" IsOn="{Binding LongTermMemoryEnabled,Mode=TwoWay}"/>
                                <TextBlock Text="{loc:Loc Key='Long-term memory can be viewed and cleared from the Memory tab.'}" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel></Border>
                        </Grid>

                        <Grid x:Name="AppearancePanel" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource SettingsPageHeaderStyle}"><TextBlock Text="{loc:Loc Key=Appearance}" Style="{StaticResource SettingsPageTitleStyle}"/></Border>
                            <Border Grid.Row="1" Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource GlassBorderBrush}" BorderThickness="1" CornerRadius="{ThemeResource SuggestionCornerRadius}"><StackPanel Style="{StaticResource SettingsPageContentStyle}">
                                <ComboBox Header="{loc:Loc Key=Theme}" ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding Theme,Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource LocalizedValue}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBox Header="{loc:Loc Key='Accent color'}" Text="{Binding AccentColor,Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                <Slider Header="{loc:Loc Key='UI font size'}" Minimum="11" Maximum="22" Value="{Binding FontSize,Mode=TwoWay}"/><Slider Header="{loc:Loc Key='Message font size'}" Minimum="12" Maximum="24" Value="{Binding MessageFontSize,Mode=TwoWay}"/><Slider Header="{loc:Loc Key='UI scale'}" Minimum="0.8" Maximum="1.4" StepFrequency="0.05" Value="{Binding UiScale,Mode=TwoWay}"/><Slider Header="{loc:Loc Key='Sidebar width'}" Minimum="220" Maximum="420" Value="{Binding SidebarWidth,Mode=TwoWay}"/><Slider Header="{loc:Loc Key='Corner radius'}" Minimum="0" Maximum="24" Value="{Binding CornerRadius,Mode=TwoWay}"/><Slider Header="{loc:Loc Key=Transparency}" Minimum="0.65" Maximum="1" StepFrequency="0.01" Value="{Binding Transparency,Mode=TwoWay}"/>
                                <ComboBox Header="{loc:Loc Key='UI density'}" ItemsSource="{Binding DensityOptions}" SelectedItem="{Binding Density,Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource LocalizedValue}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><ComboBox Header="{loc:Loc Key=Animations}" ItemsSource="{Binding AnimationOptions}" SelectedItem="{Binding Animations,Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource LocalizedValue}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                <TextBlock Text="{Binding AppearanceStatus}" Foreground="{ThemeResource SecondaryTextBrush}"/>
                            </StackPanel></Border>
                        </Grid>

                        <Grid x:Name="ConnectionsPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource SettingsPageHeaderStyle}"><StackPanel Spacing="14"><TextBlock Text="{loc:Loc Key='Connections &amp; models'}" Style="{StaticResource SettingsPageTitleStyle}"/><Button Content="{loc:Loc Key='New connection'}" Command="{Binding NewConnectionCommand}" Style="{StaticResource PremiumButtonStyle}" HorizontalAlignment="Left"/></StackPanel></Border>
                            <Border Grid.Row="1" Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource GlassBorderBrush}" BorderThickness="1" CornerRadius="{ThemeResource SuggestionCornerRadius}"><StackPanel Style="{StaticResource SettingsPageContentStyle}">
                                <Grid x:Name="ConnectionsLayout" ColumnSpacing="20" RowSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <ListView x:Name="ConnectionList" ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection,Mode=TwoWay}" MaxHeight="320" ItemContainerStyle="{StaticResource ConversationItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemTemplate><DataTemplate><Grid Padding="8"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Model}" Foreground="{ThemeResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{loc:Loc Key='● Active'}" Visibility="{Binding IsActive,Converter={StaticResource BoolVisibility}}" Foreground="{ThemeResource SuccessBrush}" FontSize="11"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                                    <StackPanel x:Name="ConnectionEditor" Grid.Column="1" Spacing="12"><TextBox Header="{loc:Loc Key=Name}" Text="{Binding ConnectionName,Mode=TwoWay}"/><TextBox Header="{loc:Loc Key='Base URL'}" Text="{Binding BaseUrl,Mode=TwoWay}"/><PasswordBox Header="{loc:Loc Key='API key (leave blank to keep current)'}" HeaderTemplate="{StaticResource ConnectionKeyHeaderTemplate}" Password="{Binding ApiKey,Mode=TwoWay}"/>
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{loc:Loc Key='Backup API keys (optional)'}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:Loc Key='Keys from this provider are tried in order if quota, rate limits, billing or authentication fail, before a response starts. The same request is sent again. Save to apply changes.'}" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                            <ItemsControl ItemsSource="{Binding BackupApiKeys}" HorizontalContentAlignment="Stretch">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Spacing="6" Margin="0,0,0,10">
                                                            <PasswordBox Header="{Binding Header}" HeaderTemplate="{StaticResource ConnectionKeyHeaderTemplate}" Password="{Binding ApiKey,Mode=TwoWay}"/>
                                                            <Button Content="{loc:Loc Key=Delete}" Command="{Binding RemoveCommand}" Style="{StaticResource PremiumButtonStyle}" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="{loc:Loc Key='Add backup API key'}" Command="{Binding AddBackupApiKeyCommand}" Style="{StaticResource PremiumButtonStyle}"/>
                                        </StackPanel><Grid services:ResponsiveForm.Enabled="True" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><AutoSuggestBox x:Name="ConnectionModelEditor" Header="{loc:Loc Key=Model}" Text="{Binding Model,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding AvailableModels}" SuggestionChosen="OnConnectionModelChosen" PlaceholderText="{loc:Loc Key=Model}" AutomationProperties.Name="{loc:Loc Key=Model}"/><Button Grid.Column="1" Content="{loc:Loc Key='Load models'}" Command="{Binding RefreshModelsCommand}" Style="{StaticResource PremiumButtonStyle}" VerticalAlignment="Bottom"/></Grid><TextBox Header="{loc:Loc Key='Organization (optional)'}" Text="{Binding Organization,Mode=TwoWay}"/><NumberBox Header="{loc:Loc Key='Timeout (seconds)'}" Minimum="5" Maximum="900" Value="{Binding TimeoutSeconds,Mode=TwoWay}"/><ProgressBar IsIndeterminate="True" Visibility="{Binding IsConnectionBusy,Converter={StaticResource BoolVisibility}}"/><StackPanel services:ResponsiveForm.Enabled="True" Orientation="Horizontal" Spacing="10"><Button Content="{loc:Loc Key=Test}" Command="{Binding TestConnectionCommand}" Style="{StaticResource PremiumButtonStyle}"/><Button Content="{loc:Loc Key=Save}" Command="{Binding SaveConnectionCommand}" Style="{StaticResource PremiumButtonStyle}"/><Button Content="{loc:Loc Key='Set active'}" Command="{Binding SetActiveConnectionCommand}" Style="{StaticResource PremiumButtonStyle}"/><Button Content="{loc:Loc Key=Delete}" Command="{Binding DeleteConnectionCommand}" Style="{StaticResource PremiumButtonStyle}"/></StackPanel><TextBlock Text="{Binding ConnectionStatus}" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel>
                                </Grid>
                            </StackPanel></Border>
                        </Grid>

                        <Grid x:Name="GenerationPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource SettingsPageHeaderStyle}"><TextBlock Text="{loc:Loc Key='Default generation settings'}" Style="{StaticResource SettingsPageTitleStyle}"/></Border>
                            <Border Grid.Row="1" Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource GlassBorderBrush}" BorderThickness="1" CornerRadius="{ThemeResource SuggestionCornerRadius}"><StackPanel Style="{StaticResource SettingsPageContentStyle}">
                                <ComboBox x:Name="ReasoningSelector" Header="{loc:Loc Key='Reasoning level'}" ItemsSource="{Binding ReasoningOptions}" SelectedItem="{Binding Reasoning,Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Loc Key='Reasoning level'}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource LocalizedValue}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                <TextBlock Text="{loc:Loc Key='idk lets Neuroset choose the reasoning level for your request.'}" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="12"/>
                                <TextBlock Text="{Binding GenerationStatus}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12"/>
                                <TextBlock Text="{loc:Loc Key='Used by every chat that does not have its own generation profile. A custom chat profile replaces all values below; the two profiles are never merged.'}" Style="{StaticResource SettingsPageDescriptionStyle}"/>
                                <ComboBox Header="{loc:Loc Key='Directive preset'}" ItemsSource="{Binding PromptPresetOptions}" SelectedItem="{Binding SelectedPromptPreset,Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName,Converter={StaticResource LocalizedValue}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                <TextBox Header="{loc:Loc Key='System prompt'}" Text="{Binding DefaultSystemPrompt,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Loc Key='Default instructions for all chats…'}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" MaxHeight="360" MaxLength="32768" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                <Grid x:Name="SamplingGrid" ColumnSpacing="14" RowSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><NumberBox Header="{loc:Loc Key=Temperature}" Minimum="0" Maximum="2" SmallChange="0.1" SpinButtonPlacementMode="Compact" Value="{Binding DefaultTemperature,Mode=TwoWay}"/><NumberBox Grid.Column="1" Header="{loc:Loc Key='Top P'}" Minimum="0" Maximum="1" SmallChange="0.05" SpinButtonPlacementMode="Compact" Value="{Binding DefaultTopP,Mode=TwoWay}"/><NumberBox Grid.Column="2" Header="{loc:Loc Key='Top K (optional)'}" Minimum="1" Maximum="100" SmallChange="1" PlaceholderText="{loc:Loc Key=Default}" SpinButtonPlacementMode="Compact" Value="{Binding DefaultTopKValue,Mode=TwoWay}"/><NumberBox Grid.Column="3" Header="{loc:Loc Key='Max output tokens'}" Minimum="1" Maximum="1000000" SmallChange="256" SpinButtonPlacementMode="Compact" Value="{Binding DefaultMaxTokens,Mode=TwoWay}"/></Grid>
                                <Grid x:Name="PenaltyGrid" ColumnSpacing="14" RowSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><NumberBox Header="{loc:Loc Key='Presence penalty'}" Minimum="-2" Maximum="2" SmallChange="0.1" SpinButtonPlacementMode="Compact" Value="{Binding DefaultPresencePenalty,Mode=TwoWay}"/><NumberBox Grid.Column="1" Header="{loc:Loc Key='Frequency penalty'}" Minimum="-2" Maximum="2" SmallChange="0.1" SpinButtonPlacementMode="Compact" Value="{Binding DefaultFrequencyPenalty,Mode=TwoWay}"/><NumberBox Grid.Column="2" Header="{loc:Loc Key='Repetition penalty (optional)'}" Minimum="0" Maximum="2" SmallChange="0.05" PlaceholderText="{loc:Loc Key=Default}" SpinButtonPlacementMode="Compact" Value="{Binding DefaultRepetitionPenaltyValue,Mode=TwoWay}"/><NumberBox Grid.Column="3" Header="{loc:Loc Key='Seed (optional)'}" PlaceholderText="{loc:Loc Key=Random}" SpinButtonPlacementMode="Compact" Value="{Binding DefaultSeedValue,Mode=TwoWay}"/></Grid>
                                <TextBox Header="{loc:Loc Key='Stop sequences (one per line, up to 4)'}" Text="{Binding DefaultStopSequences,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="96" MaxHeight="180" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                <ToggleSwitch Header="{loc:Loc Key='Allow agent tools'}" OffContent="{loc:Loc Key=Disabled}" OnContent="{loc:Loc Key=Enabled}" IsOn="{Binding DefaultEnableTools,Mode=TwoWay}"/>
                                <TextBlock Text="{loc:Loc Key='Research modules'}" FontSize="18" FontWeight="SemiBold"/>
                                <ToggleSwitch Header="{loc:Loc Key='Input perturbation'}" OffContent="{loc:Loc Key=Disabled}" OnContent="{loc:Loc Key=Enabled}" IsOn="{Binding DefaultParseltongueEnabled,Mode=TwoWay}"/>
                                <ComboBox Header="{loc:Loc Key=Intensity}" ItemsSource="{Binding ParseltongueIntensityOptions}" SelectedItem="{Binding SelectedPerturbationIntensity,Mode=TwoWay}" HorizontalAlignment="Stretch" Visibility="{Binding DefaultParseltongueEnabled,Converter={StaticResource BoolVisibility}}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName,Converter={StaticResource LocalizedValue}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                <ComboBox Header="{loc:Loc Key='Perturbation technique'}" ItemsSource="{Binding ParseltongueTechniqueOptions}" SelectedItem="{Binding SelectedPerturbationTechnique,Mode=TwoWay}" HorizontalAlignment="Stretch" Visibility="{Binding DefaultParseltongueEnabled,Converter={StaticResource BoolVisibility}}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName,Converter={StaticResource LocalizedValue}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                <TextBox Header="{loc:Loc Key='Custom triggers (one per line)'}" Text="{Binding DefaultParseltongueCustomTriggers,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="150" Visibility="{Binding DefaultParseltongueEnabled,Converter={StaticResource BoolVisibility}}"/>
                                <ToggleSwitch Header="{loc:Loc Key='Context-adaptive sampling'}" OffContent="{loc:Loc Key=Disabled}" OnContent="{loc:Loc Key=Enabled}" IsOn="{Binding DefaultAutoTuneEnabled,Mode=TwoWay}"/>
                                <ComboBox Header="{loc:Loc Key='AutoTune strategy'}" ItemsSource="{Binding AutoTuneStrategyOptions}" SelectedItem="{Binding SelectedSamplingStrategy,Mode=TwoWay}" HorizontalAlignment="Stretch" Visibility="{Binding DefaultAutoTuneEnabled,Converter={StaticResource BoolVisibility}}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName,Converter={StaticResource LocalizedValue}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                <ToggleSwitch Header="{loc:Loc Key='Hedge reducer'}" OffContent="{loc:Loc Key=Disabled}" OnContent="{loc:Loc Key=Enabled}" IsOn="{Binding DefaultHedgeReducerEnabled,Mode=TwoWay}"/>
                                <ToggleSwitch Header="{loc:Loc Key='Direct response mode'}" OffContent="{loc:Loc Key=Disabled}" OnContent="{loc:Loc Key=Enabled}" IsOn="{Binding DefaultDirectModeEnabled,Mode=TwoWay}"/>
                                <ToggleSwitch Header="{loc:Loc Key='Casual response mode'}" OffContent="{loc:Loc Key=Disabled}" OnContent="{loc:Loc Key=Enabled}" IsOn="{Binding DefaultCasualModeEnabled,Mode=TwoWay}"/>
                                <ToggleSwitch Header="{loc:Loc Key='Parallel model race'}" OffContent="{loc:Loc Key=Disabled}" OnContent="{loc:Loc Key=Enabled}" IsOn="{Binding DefaultMultiModelRacingEnabled,Mode=TwoWay}"/>
                                <NumberBox Header="{loc:Loc Key='Participating models'}" Minimum="2" Maximum="8" Value="{Binding DefaultRacingModelCount,Mode=TwoWay}" SpinButtonPlacementMode="Compact" HorizontalAlignment="Stretch" Visibility="{Binding DefaultMultiModelRacingEnabled,Converter={StaticResource BoolVisibility}}"/>
                                <InfoBar IsOpen="True" Severity="Informational" Title="{loc:Loc Key='Chat overrides'}" Message="{loc:Loc Key='Enable custom generation settings in Chat settings to replace this entire profile for that conversation.'}"/><TextBlock Text="{Binding GenerationStatus}" Foreground="{ThemeResource SecondaryTextBrush}"/>
                            </StackPanel></Border>
                        </Grid>

                        <Grid x:Name="ToolsPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource SettingsPageHeaderStyle}"><TextBlock Text="{loc:Loc Key=Tools}" Style="{StaticResource SettingsPageTitleStyle}"/></Border>
                            <Border Grid.Row="1" Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource GlassBorderBrush}" BorderThickness="1" CornerRadius="{ThemeResource SuggestionCornerRadius}"><StackPanel Style="{StaticResource SettingsPageContentStyle}"><TextBlock Text="{loc:Loc Key='Rich Tables · Canvas · Widgets · Web Search · Web Fetch · Local Knowledge · Workspace Files · Python · Process Runner · HTTP/API · Isolated Database · Memory · Scheduler · Notifications'}" TextWrapping="Wrap"/><Border Background="{ThemeResource ElevatedSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="{ThemeResource CardCornerRadius}" Padding="16"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource SelectionBrush}"><FontIcon Glyph="&#xE1D0;" Foreground="{ThemeResource AccentBrush}"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{loc:Loc Key='Native presentation tools'}" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc Key='Polished structured tables, separate Markdown or code canvases, calculator, conversions, weather, world time, and live sports cards.'}" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}"/></StackPanel></Grid></Border><InfoBar IsOpen="True" Severity="Informational" Title="{loc:Loc Key=Presentations}" Message="{loc:Loc Key='Animated PPTX and ODP decks with generated illustrations, automatic styling and targeted revisions. Ask for a presentation in the chat.'}"/><InfoBar IsOpen="True" Severity="Informational" Title="{loc:Loc Key='Coding agent'}" Message="{loc:Loc Key='Full-access Coding chats can edit files and directly run git, dotnet, compilers, test runners, package managers, and project scripts in their selected working directory.'}"/><InfoBar IsOpen="True" Severity="Informational" Title="{loc:Loc Key='Advanced coding workflow'}" Message="{loc:Loc Key='Project instructions, reusable skills, coding subagents, MCP integrations, atomic patches, structured Git review, recoverable checkpoints, managed worktrees, and automatic long-context compaction are enabled in Coding chats.'}"/><InfoBar IsOpen="True" Severity="Informational" Title="{loc:Loc Key='Untrusted input boundary'}" Message="{loc:Loc Key='Web pages, documents, repository content, and tool results are always treated as untrusted data and cannot override system instructions.'}"/></StackPanel></Border>
                        </Grid>

                        <Grid x:Name="PermissionsPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource SettingsPageHeaderStyle}"><TextBlock Text="{loc:Loc Key=Permissions}" Style="{StaticResource SettingsPageTitleStyle}"/></Border>
                            <Border Grid.Row="1" Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource GlassBorderBrush}" BorderThickness="1" CornerRadius="{ThemeResource SuggestionCornerRadius}"><StackPanel Style="{StaticResource SettingsPageContentStyle}">
                                <TextBlock Text="{loc:Loc Key='Safe reads are allowed by default. Code execution, writes, mutations, scheduler changes, and HTTP mutations request confirmation.'}" Style="{StaticResource SettingsPageDescriptionStyle}"/>
                                <InfoBar IsOpen="True" Severity="Warning" Title="{loc:Loc Key='Full autonomy'}" Message="{loc:Loc Key='Full autonomy removes every tool permission prompt. The model may run code, install dependencies, write or delete files, change scheduled tasks, and perform network mutations without confirmation.'}"/>
                                <ToggleSwitch Header="{loc:Loc Key='Full autonomy'}" OffContent="{loc:Loc Key=Disabled}" OnContent="{loc:Loc Key=Enabled}" IsOn="{Binding FullAutonomyEnabled,Mode=TwoWay}"/>
                                <TextBlock Text="{loc:Loc Key='When enabled, Neuroset automatically approves every tool action. The model can still ask conversational questions when it needs task details.'}" Style="{StaticResource SettingsPageDescriptionStyle}"/>
                                <TextBlock Text="{Binding PermissionsStatus}" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                <ListView ItemsSource="{Binding PermissionRules}"><ListView.ItemTemplate><DataTemplate><Grid Padding="8" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding ToolName}"/><TextBlock Grid.Column="1" Text="{Binding Risk,Converter={StaticResource LocalizedValue}}"/><TextBlock Grid.Column="2" Text="{Binding Policy,Converter={StaticResource LocalizedValue}}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                            </StackPanel></Border>
                        </Grid>

                        <Grid x:Name="MemoryPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource SettingsPageHeaderStyle}"><Grid><TextBlock Text="{loc:Loc Key=Memory}" Style="{StaticResource SettingsPageTitleStyle}"/><Button Content="{loc:Loc Key='Clear all'}" Command="{Binding ClearMemoryCommand}" HorizontalAlignment="Right" Style="{StaticResource PremiumButtonStyle}"/></Grid></Border>
                            <Border Grid.Row="1" Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource GlassBorderBrush}" BorderThickness="1" CornerRadius="{ThemeResource SuggestionCornerRadius}"><StackPanel Style="{StaticResource SettingsPageContentStyle}"><ListView ItemsSource="{Binding Memories}"><ListView.ItemTemplate><DataTemplate><Grid Padding="10" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Scope,Converter={StaticResource LocalizedValue}}"/><TextBlock Grid.Column="1" Text="{Binding Content}" TextWrapping="Wrap"/><Button Grid.Column="2" Content="{loc:Loc Key=Delete}" Command="{Binding DataContext.DeleteMemoryCommand,ElementName=SettingsNavigation}" CommandParameter="{Binding}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border>
                        </Grid>

                        <Grid x:Name="KnowledgePanel" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource SettingsPageHeaderStyle}"><TextBlock Text="{loc:Loc Key='Knowledge base'}" Style="{StaticResource SettingsPageTitleStyle}"/></Border>
                            <Border Grid.Row="1" Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource GlassBorderBrush}" BorderThickness="1" CornerRadius="{ThemeResource SuggestionCornerRadius}"><StackPanel Style="{StaticResource SettingsPageContentStyle}"><TextBlock Text="{loc:Loc Key='Add PDF, TXT, MD, DOCX, CSV, or JSON files from the chat attachment button. Text extraction, embeddings, and vector search run locally.'}" Style="{StaticResource SettingsPageDescriptionStyle}"/><ListView ItemsSource="{Binding KnowledgeSources}"><ListView.ItemTemplate><DataTemplate><Grid Padding="10" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding LocalPath}" Foreground="{ThemeResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Status,Converter={StaticResource LocalizedValue}}"/><Button Grid.Column="2" Content="{loc:Loc Key=Remove}" Command="{Binding DataContext.DeleteKnowledgeCommand,ElementName=SettingsNavigation}" CommandParameter="{Binding}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border>
                        </Grid>

                        <Grid x:Name="NotificationsPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource SettingsPageHeaderStyle}"><TextBlock Text="{loc:Loc Key=Notifications}" Style="{StaticResource SettingsPageTitleStyle}"/></Border>
                            <Border Grid.Row="1" Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource GlassBorderBrush}" BorderThickness="1" CornerRadius="{ThemeResource SuggestionCornerRadius}"><StackPanel Style="{StaticResource SettingsPageContentStyle}"><TextBlock Text="{loc:Loc Key='Control whether Neuroset may display System notifications for completed scheduled work and background events.'}" Style="{StaticResource SettingsPageDescriptionStyle}"/><ToggleSwitch Header="{loc:Loc Key='System notifications'}" IsOn="{Binding NotificationsEnabled,Mode=TwoWay}"/><InfoBar IsOpen="True" Severity="Informational" Title="{loc:Loc Key='Local control'}" Message="{loc:Loc Key='Notification content is created locally and follows the permissions granted to the active chat or scheduled task.'}"/></StackPanel></Border>
                        </Grid>

                        <Grid x:Name="SchedulerPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource SettingsPageHeaderStyle}"><TextBlock Text="{loc:Loc Key=Scheduler}" Style="{StaticResource SettingsPageTitleStyle}"/></Border>
                            <Border Grid.Row="1" Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource GlassBorderBrush}" BorderThickness="1" CornerRadius="{ThemeResource SuggestionCornerRadius}"><StackPanel Style="{StaticResource SettingsPageContentStyle}"><TextBlock Text="{loc:Loc Key='Persistent once, daily, weekly, interval, and cron tasks run locally while Neuroset is active and resume after restart.'}" Style="{StaticResource SettingsPageDescriptionStyle}"/><ListView ItemsSource="{Binding ScheduledTasks}"><ListView.ItemTemplate><DataTemplate><Grid Padding="10" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Prompt}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding NextRunAt}"/><Button Grid.Column="2" Content="{loc:Loc Key=Delete}" Command="{Binding DataContext.DeleteScheduledTaskCommand,ElementName=SettingsNavigation}" CommandParameter="{Binding}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border>
                        </Grid>

                        <Grid x:Name="ReliabilityPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource SettingsPageHeaderStyle}"><TextBlock Text="{loc:Loc Key='Model reliability'}" Style="{StaticResource SettingsPageTitleStyle}"/></Border>
                            <Border Grid.Row="1" Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource GlassBorderBrush}" BorderThickness="1" CornerRadius="{ThemeResource SuggestionCornerRadius}"><StackPanel Style="{StaticResource SettingsPageContentStyle}">
                                <TextBlock Text="{loc:Loc Key='Run isolated, reproducible checks against the active OpenAI-compatible connection. The suite uses harmless markers and never changes normal chat requests.'}" Style="{StaticResource SettingsPageDescriptionStyle}"/>
                                <Border Background="{ThemeResource ElevatedSurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="{ThemeResource CardCornerRadius}" Padding="16"><StackPanel Spacing="10"><TextBlock Text="{loc:Loc Key='Active connection'}" FontWeight="SemiBold"/><TextBlock Text="{Binding ReliabilityConnectionLabel}" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}"/><Grid services:ResponsiveForm.Enabled="True" ColumnSpacing="18" MaxWidth="820" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="8"><ToggleSwitch Header="{loc:Loc Key='Instruction hierarchy'}" IsOn="{Binding TestInstructionHierarchy,Mode=TwoWay}"/><ToggleSwitch Header="{loc:Loc Key='Benign obfuscation'}" IsOn="{Binding TestObfuscationRobustness,Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="1" Spacing="8"><ToggleSwitch Header="{loc:Loc Key='Refusal calibration'}" IsOn="{Binding TestRefusalCalibration,Mode=TwoWay}"/><ToggleSwitch Header="{loc:Loc Key='Assistant prefill compatibility'}" IsOn="{Binding TestAssistantPrefill,Mode=TwoWay}"/></StackPanel></Grid><StackPanel services:ResponsiveForm.Enabled="True" Orientation="Horizontal" Spacing="8"><Button Content="{loc:Loc Key='Run reliability suite'}" Command="{Binding RunReliabilityCommand}" Style="{StaticResource PremiumButtonStyle}" Background="{ThemeResource AccentBrush}"/><Button Content="{loc:Loc Key=Stop}" Command="{Binding StopReliabilityCommand}" Visibility="{Binding IsReliabilityRunning,Converter={StaticResource BoolVisibility}}" Style="{StaticResource PremiumButtonStyle}"/><Button Content="{loc:Loc Key='Clear report'}" Command="{Binding ClearReliabilityReportCommand}" Style="{StaticResource PremiumButtonStyle}"/><ProgressRing Width="20" Height="20" IsActive="{Binding IsReliabilityRunning}"/></StackPanel><TextBlock Text="{Binding ReliabilityStatus}" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}"/></StackPanel></Border>
                                <ItemsControl ItemsSource="{Binding ReliabilityResults}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="{ThemeResource SmallCornerRadius}" Padding="14" Margin="0,0,0,8"><StackPanel Spacing="7"><Grid><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Status,Converter={StaticResource LocalizedValue}}" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}"/><TextBlock Text="{Binding Category,Converter={StaticResource LocalizedValue}}" Foreground="{ThemeResource SecondaryTextBrush}"/></StackPanel><TextBlock Text="{Binding Latency}" HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/></Grid><TextBlock Text="{Binding Name,Converter={StaticResource LocalizedValue}}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary,Converter={StaticResource LocalizedValue}}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{loc:Loc Key='Refusal score:'}" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/><TextBlock Text="{Binding RefusalScore}" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/></StackPanel><Expander Header="{loc:Loc Key='Response preview'}"><TextBox Text="{Binding ResponsePreview}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160"/></Expander></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <StackPanel Visibility="{Binding HasReliabilityReport,Converter={StaticResource BoolVisibility}}" Spacing="8"><TextBlock Text="{loc:Loc Key='Markdown report'}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc Key='The report contains no API key and can be copied with Ctrl+A, Ctrl+C.'}" Foreground="{ThemeResource SecondaryTextBrush}"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MinHeight="260" MaxHeight="420"><TextBox Text="{Binding ReliabilityReport,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="{StaticResource MonospaceFontFamily}" BorderThickness="0"/></ScrollViewer></StackPanel>
                            </StackPanel></Border>
                        </Grid>

                        <Grid x:Name="AdvancedPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource SettingsPageHeaderStyle}"><TextBlock Text="{loc:Loc Key=Advanced}" Style="{StaticResource SettingsPageTitleStyle}"/></Border>
                            <Border Grid.Row="1" Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource GlassBorderBrush}" BorderThickness="1" CornerRadius="{ThemeResource SuggestionCornerRadius}"><StackPanel Style="{StaticResource SettingsPageContentStyle}">
                                <TextBlock Text="{loc:Loc Key='Agent runtime'}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Loc Key='Chat starts with a compact budget, can request more iterations from a concrete work plan, blocks repeated tool loops, and always gets a final synthesis turn without tools.'}" Style="{StaticResource SettingsPageDescriptionStyle}"/>
                                <Grid services:ResponsiveForm.Enabled="True" ColumnSpacing="16" MaxWidth="760" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <NumberBox Header="{loc:Loc Key='Chat initial budget'}" Minimum="1" Maximum="1000" Value="{Binding AgentMaxIterations,Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                    <NumberBox Grid.Column="1" Header="{loc:Loc Key='Chat hard ceiling'}" Minimum="1" Maximum="1000" Value="{Binding AgentHardMaxIterations,Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                </Grid>
                                <Grid services:ResponsiveForm.Enabled="True" ColumnSpacing="16" MaxWidth="760" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <NumberBox Header="{loc:Loc Key='Coding hard ceiling'}" Minimum="16" Maximum="1000" Value="{Binding CodingAgentMaxIterations,Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                    <NumberBox Grid.Column="1" Header="{loc:Loc Key='Coding timeout (minutes)'}" Minimum="1" Maximum="720" Value="{Binding CodingAgentTimeoutMinutes,Mode=TwoWay}" SpinButtonPlacementMode="Compact"/>
                                </Grid>
                                <NumberBox Header="{loc:Loc Key='Provider retries'}" Minimum="0" Maximum="10" Value="{Binding AgentRetryCount,Mode=TwoWay}" SpinButtonPlacementMode="Compact" MaxWidth="372" HorizontalAlignment="Left"/>
                                <TextBlock Text="{loc:Loc Key='Changes are saved automatically and apply to the next generation.'}" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                <TextBlock Text="{loc:Loc Key='Database, encrypted keys, logs, attachments, workspaces, and local models are stored in the application data directory on this device.'}" TextWrapping="Wrap"/>
                                <TextBlock Text="{loc:Loc Key='Structured logs never include API keys or credentials.'}" Foreground="{ThemeResource SuccessBrush}"/>
                            </StackPanel></Border>
                        </Grid>

                        <Grid x:Name="AboutPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource SettingsPageHeaderStyle}"><TextBlock Text="{loc:Loc Key=About}" Style="{StaticResource SettingsPageTitleStyle}"/></Border>
                            <Border Grid.Row="1" Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource GlassBorderBrush}" BorderThickness="1" CornerRadius="{ThemeResource SuggestionCornerRadius}"><StackPanel Style="{StaticResource SettingsPageContentStyle}"><TextBlock Text="Neuroset" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc Key='Version 1.0.0 · Windows and Android AI client'}"/><TextBlock Text="{loc:Loc Key='Built with .NET 10, WinUI 3, Windows App SDK, SQLite, CommunityToolkit.Mvvm, Serilog, Markdig, ColorCode, ONNX Runtime, PdfPig, and Open XML SDK.'}" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}"/></StackPanel></Border>
                        </Grid>
                    </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
